{
  "name": "@harshy/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harshy/core": "workspace:*"
  },
  "peerDependencies": {
    "@harshy/native": "workspace:*",
    "expo": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "@harshy/native": { "optional": true },
    "expo": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@harshy/config": "workspace:*",
    "@harshy/native": "workspace:*",
    "eslint": "^9.28.0",
    "expo": "~57.0.21",
    "react-native": "0.86.3",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
